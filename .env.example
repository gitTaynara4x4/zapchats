# =========================
# Ambiente
# =========================
# dev | prod  (controla CORS no main.py e possíveis comportamentos)
ENV=prod
# Fuso horário usado para exibir horas no WS (persistência sempre UTC)
APP_TZ=America/Sao_Paulo

# =========================
# Banco de dados (PostgreSQL)
# =========================
PGHOST=9ywrah.easypanel.host
PGPORT=5431
PGDATABASE=zapchats
PGUSER=postgres
PGPASSWORD=promessa20
DATABASE_URL=postgresql://postgres:promessa20@9ywrah.easypanel.host:5431/zapchats
PGCONNECT_TIMEOUT=20

# =========================
# JWT / Auth
# =========================
# Troque por um segredo forte (32+ chars)
JWT_SECRET=troque-este-segredo-super-seguro
# minutos (padrão 24h se ausente; o código usa constante, mas manter aqui ajuda)
JWT_EXP_MINUTES=1440

# =========================
# E-mail (recuperação de senha)
# =========================
EMAIL_REMETENTE=recuperazapchats@gmail.com
EMAIL_SENHA=qrwfnzukgfkopifr

# =========================
# Cookies / CSRF (double-submit)
# =========================
# Em produção com HTTPS use true
COOKIE_SECURE=false
# "lax" é o padrão seguro; use "none" apenas se o front estiver em outro domínio (requer HTTPS)
COOKIE_SAMESITE=lax

# Nome do cookie CSRF e escopo de path (só é enviado no /api/auth/refresh)
CSRF_COOKIE_NAME=csrf_token
CSRF_COOKIE_PATH=/api/auth/refresh
# 30 dias em segundos
CSRF_COOKIE_MAX_AGE=2592000

# =========================
# Flags de escrita (manutenção / cadastro / recuperação)
# =========================
READONLY_MODE=false
DISABLE_REGISTER=false
DISABLE_PASSWORD_RECOVERY=false

# =========================
# Trial / Assinatura
# =========================
TRIAL_DAYS=7

# =========================
# Throttle de login (backend/security/login_throttle)
# =========================
# janela para contar falhas (segundos)
LOGIN_FAIL_WINDOW_SEC=900
# falhas permitidas nessa janela antes do lock
LOGIN_FAIL_MAX=5
# duração do lock (segundos)
ACCOUNT_LOCK_SEC=900

# =========================
# Evolution API
# =========================
# O listener WS usa EVOLUTION_URL e converte http(s)->ws(s) automaticamente.
EVOLUTION_URL=https://zapchats-evolution-api.9ywrah.easypanel.host
EVOLUTION_APIKEY=429683C4C977415CAAFCCE10F7D57E11
# compat (o código também lê EVOLUTION_KEY)
EVOLUTION_KEY=${EVOLUTION_APIKEY}

# Habilita o listener global de WebSocket do Evolution
EVOLUTION_WS_SUBSCRIBE=true
# (Opcional) ws dedicado — só defina se precisar forçar um endpoint ws/wss específico
# EVOLUTION_WS_URL=wss://zapchats-evolution-api.9ywrah.easypanel.host

# Forçar QR assim que o front conecta no WS da instância
EVOLUTION_FORCE_QR_ON_WS=true
# Dedup de QR (ms) — evita spam de QR repetido
EVOLUTION_QR_DEDUP_WINDOW_MS=1200

# Ativa logs detalhados de mensagens/eventos no backend (útil pra debug)
EVO_DEBUG_MESSAGES=true

# =========================
# Sincronização (flags usadas no código)
# =========================
SYNC_CONTACTS_ON_CONNECT=true
SYNC_CHATS_ON_CONNECT=false
# Desligado pra evitar "aguardando histórico" travar a UX; ligue depois se precisar
ENABLE_MESSAGES_SET=false

# =========================
# Histórico (import ao conectar)
# =========================
# Força 24h independente do que o front pedir
HISTORY_LIMIT_HOURS=24
# Se false, 7d fica desativado mesmo que a instância peça
ALLOW_HISTORY_7D=false
# CAP por rodada de import
HISTORY_MAX_IMPORT=3000
# commit a cada N inserções
HISTORY_BATCH_COMMIT=250
# ceder o loop a cada N (apenas cooperativo, reduz travadas)
HISTORY_SLEEP_EVERY=500
# não baixar/armazenar mídia durante histórico (só texto)
DISABLE_MEDIA_ON_HISTORY=true
# evitar reprocessar logo após finalizar histórico
HISTORY_IGNORE_AFTER_DONE_MIN=30

# =========================
# RabbitMQ
# =========================
USE_RABBIT=true
RABBITMQ_URI=amqp://zap:rabbitdazapchat@zapchats-rabbitmq.9ywrah.easypanel.host:5672/
RABBITMQ_EXCHANGE_NAME=evolution_exchange
RABBITMQ_QUEUE_NAME=zapchats.backend
# Bindings padrão (tudo). Pode ser uma lista separada por vírgulas, ex: evo.#,MESSAGES_*,SEND_MESSAGE
RABBITMQ_BINDINGS=#

# =========================
# Redis (cache / QR snapshot / lid map)
# =========================
REDIS_URL=redis://default:6850388cb4f314b6ca8b@9ywrah.easypanel.host:9856
REDIS_PREFIX=zap
REDIS_TTL_SECONDS=120

# =========================
# CORS (apenas referência)
# =========================
# No código, as origens estão hardcoded:
# DEV_ORIGINS = http://127.0.0.1:8000, http://localhost:8000, 127.0.0.1:5500, localhost:5500
# PROD_ORIGINS = https://zapschat.com.br, https://www.zapschat.com.br
# Se precisar mudar, ajuste no código das rotas/CORS.

# =========================
# Templates / Assets
# =========================
RESET_EMAIL_HTML=frontend/reset_password_email.html
